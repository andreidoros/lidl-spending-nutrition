	measure 'Kcal per Ambalaj' =
			
			VAR IsVrac = SELECTEDVALUE(DimProducts[is_weighed_default])
			VAR GreutatePachet = SELECTEDVALUE(DimProducts[package_weight_g])
			VAR Kcal100 = SELECTEDVALUE(DimProducts[kcal_100g])
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Kcal100), BLANK(),
			        -- Dacă e ambalaj fix (ex: 200g crenvurști -> 434 kcal)
			        NOT(ISBLANK(GreutatePachet)) && GreutatePachet > 0, (GreutatePachet / 100) * Kcal100,
			        -- Dacă e vrac pur (fără ambalaj fix), raportăm convențional la 1 kg
			        IsVrac = TRUE(), Kcal100 * 10,
			        BLANK()
			    )
		lineageTag: d84f5f1c-73ba-494d-a5ce-ad3a5bee931a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

