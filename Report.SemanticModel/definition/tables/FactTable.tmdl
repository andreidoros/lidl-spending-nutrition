	measure 'Unit Price' = DIVIDE(SUM(FactTable[line_total]), SUM(FactTable[quantity]))
		formatString: #,0.0\ "lei";-#,0.0\ "lei";#,0.0\ "lei"
		lineageTag: d11d4cf9-2037-430e-b760-17b15bd83f5a

