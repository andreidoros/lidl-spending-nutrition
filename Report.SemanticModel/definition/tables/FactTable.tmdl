	measure NutriScore_Color =
			
			VAR Score = [Weighted NutriScore (g)]
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(Score), BLANK(),
			        Score < 0,        "#038141",  -- Clasa A (Verde închis)
			        Score <= 2,       "#85BB2F",  -- Clasa B (Verde deschis)
			        Score <= 10,      "#FECB02",  -- Clasa C (Galben)
			        Score <= 18,      "#EE8100",  -- Clasa D (Portocaliu)
			        "#E63E11"                     -- Clasa E (Roșu)
			    )
		lineageTag: fb6a9868-5398-4b4e-a6b2-3f8401b74e85

	measure Products = DISTINCTCOUNTNOBLANK(FactTable[product_key])
		formatString: 0
