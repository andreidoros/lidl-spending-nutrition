	measure 'Weight (g)' =
			
			SUMX(
			    FactTable,
			    VAR IsWeighed = RELATED(DimProducts[is_weighed_default])
			    VAR PackageWeight = RELATED(DimProducts[package_weight_g])
			    RETURN
			        IF(
			            IsWeighed = TRUE(),
			            FactTable[quantity] * 1000,
			            FactTable[quantity] * COALESCE(PackageWeight, 100)
			        )
			)
		formatString: #,0
		lineageTag: 508698a1-4ed7-46ba-bdc9-804526e92771

		annotation PBI_FormatHint = {"isDecimal":true}

	measure 'Total Kcal' = SUMX(FactTable, (FactTable[Weight (g)] / 100) * RELATED(DimProducts[kcal_100g]))
