	measure 'Total Spend (Ajustat la inflatie)' = ```
			
			-- 1. Identificăm cea mai recentă lună care are efectiv IPC raportat
			VAR UltimaLunaCuIPC = 
			    CALCULATE(
			        MAX(dim_inflatie[an_luna]),
			        REMOVEFILTERS(dim_inflatie),
			        NOT(ISBLANK(dim_inflatie[ipc_alimentar])),
			        dim_inflatie[ipc_alimentar] > 0
			    )
			
			-- 2. Preluăm indicele oficial al lunii de bază (ancora de preț curent)
			VAR IPC_Baza = 
			    CALCULATE(
			        MAX(dim_inflatie[ipc_alimentar]),
			        REMOVEFILTERS(dim_inflatie),
			        dim_inflatie[an_luna] = UltimaLunaCuIPC
			    )
			
			-- 3. Deflatăm fiecare tranzacție în funcție de luna în care a fost emis bonul
			RETURN
			    SUMX(
			        FactTable,
			        VAR AnLunaTranzactie = FORMAT(FactTable[date], "YYYY-MM")
			        VAR IPC_Tranzactie = 
			            LOOKUPVALUE(
			                dim_inflatie[ipc_alimentar],
			                dim_inflatie[an_luna], AnLunaTranzactie
			            )
			        -- Dacă luna nu e raportată încă (Sept/Oct), lăsăm factor 1.0 (prețuri curente)
			        VAR FactorDeflatare = 
			            IF(
			                ISBLANK(IPC_Tranzactie) || IPC_Tranzactie <= 0,
			                1.0,
			                DIVIDE(IPC_Baza, IPC_Tranzactie)
			            )
			        RETURN
			            FactTable[net_line_total] * FactorDeflatare
			    )
			```
		lineageTag: 99f8089b-08ca-4f10-ad88-6082047cd681

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Spend' =
			
			VAR Selectie = SELECTEDVALUE(SlicerInflatie[Optiune], "Nominal (Preț Istoric)")
			RETURN
			    IF(
			        Selectie = "Ajustat la Inflație (Preț Curent)",
			        [Total Spend (Ajustat la inflatie)],
			        [Total Spend (Nominal)]
			    )
		formatString: #,0.0\ "lei";-#,0.0\ "lei";#,0.0\ "lei"
		lineageTag: 040cfca4-4663-445a-aa86-95f65e500f53

		annotation PBI_FormatHint = {"currencyCulture":"ro-RO"}

