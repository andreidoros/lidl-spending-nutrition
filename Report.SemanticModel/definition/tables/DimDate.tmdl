			lineageTag: ca48c54c-9a59-42c1-b59c-079f7c3b4280
			column: Date

	partition DimDate = calculated
		mode: import
		source = ```
				
				// 1. Delimitare interval (ani compleți obligatorii pentru Time Intelligence)
				// Poți seta anii static sau dinamic pe baza fact-ului (ex: YEAR(MIN(FactSales[OrderDate])))
				VAR _StartYear = 2020
				VAR _EndYear   = 2030
				
				VAR _StartDate = DATE(_StartYear, 1, 1)
				VAR _EndDate   = DATE(_EndYear, 12, 31)
				
				// 2. Generare serie contiguă de date
				VAR _BaseCalendar = CALENDAR(_StartDate, _EndDate)
				
				// 3. Data de referință pentru calcule relative
				VAR _Today = TODAY()
				
				RETURN
				    ADDCOLUMNS(
				        _BaseCalendar,
				        
				        // --- CHEI ȘI TIMP PRINCIPAL ---
				        "DateKey", 
				            YEAR([Date]) * 10000 + MONTH([Date]) * 100 + DAY([Date]),
				        
				        // --- AN ---
				        "Year", 
				            YEAR([Date]),
				        
				        // --- TRIMESTRU ---
				        "QuarterNumber", 
				            QUARTER([Date]),
				        "Quarter", 
				            "Q" & QUARTER([Date]),
				        "QuarterYear", 
				            "Q" & QUARTER([Date]) & " " & YEAR([Date]),
				        "QuarterYearKey", 
				            YEAR([Date]) * 10 + QUARTER([Date]),
				        
				        // --- LUNĂ ---
				        "MonthNumber", 
				            MONTH([Date]),
				        "MonthName", 
				            FORMAT([Date], "mmm"),
				        "MonthYear", 
				            FORMAT([Date], "mmm yyyy"),
				        "MonthYearKey", 
				            YEAR([Date]) * 100 + MONTH([Date]),
				        
				        // --- ZI ---
				        "DayOfMonth", 
				            DAY([Date]),
				        "DayOfWeekNumber", 
				            WEEKDAY([Date], 2), -- 1 = Luni, 7 = Duminică
				        "DayOfWeekName", 
				            FORMAT([Date], "ddd"),
				        
				        // --- SĂPTĂMÂNĂ ---
				        "WeekNumber", 
				            WEEKNUM([Date], 2), -- Început de săptămână: Luni
				        "WeekYear", 
				            "W" & FORMAT(WEEKNUM([Date], 2), "00") & " " & YEAR([Date]),
				        "WeekYearKey", 
				            YEAR([Date]) * 100 + WEEKNUM([Date], 2),
				        
				        // --- FLAG-URI STATUT ZI ---
				        "IsWeekend", 
				            IF(WEEKDAY([Date], 2) >= 6, TRUE(), FALSE()),
				        "IsWorkingDay", 
				            IF(WEEKDAY([Date], 2) < 6, TRUE(), FALSE()),
				        
				        // --- OFFSET-URI RELATIVE (Calculate la momentul refresh-ului) ---
				        "DayOffset", 
				            INT([Date] - _Today),
				        "MonthOffset", 
				            (YEAR([Date]) - YEAR(_Today)) * 12 + MONTH([Date]) - MONTH(_Today),
				        "YearOffset", 
				            YEAR([Date]) - YEAR(_Today),
				        
				        // --- FLAG-URI PERIOADĂ CURENTĂ / TRECUTĂ ---
				        "IsCurrentYear", 
				            IF(YEAR([Date]) = YEAR(_Today), TRUE(), FALSE()),
				        "IsCurrentMonth", 
				            IF(YEAR([Date]) = YEAR(_Today) && MONTH([Date]) = MONTH(_Today), TRUE(), FALSE()),
				        "IsPast", 
				            IF([Date] < _Today, TRUE(), FALSE())
				    )
				```

	annotation PBI_Id = 7ae1faa88c7a4c578daea0299cf39572

