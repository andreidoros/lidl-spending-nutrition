table 'Time Intelligence'
	lineageTag: 92055dbf-4c25-47a4-a8b0-6f0b3b749077

	calculationGroup

		calculationItem Current = SELECTEDMEASURE()

		calculationItem 'Same Period Last Year' =
				CALCULATE (
				    SELECTEDMEASURE (),
				    DATEADD ( 'DimDate'[Date], -1, YEAR )
				)

		calculationItem 'Same Period Last Quarter' =
				CALCULATE(
				    SELECTEDMEASURE(),
				    DATEADD('DimDate'[Date], -1, QUARTER)
				    )

		calculationItem 'Same Period Last Month' =
				CALCULATE(
				    SELECTEDMEASURE(),
				    DATEADD(DimDate[Date], -1, MONTH)
				)

		calculationItem 'Same Period Last Week' =
				CALCULATE(
				    SELECTEDMEASURE(),
				    DATEADD(DimDate[Date], -7, DAY)
				)

		calculationItem 'SPLM Diff' = ```
				
				VAR _Current = SELECTEDMEASURE ()
				VAR _Prior = 
				    CALCULATE (
				        SELECTEDMEASURE (),
				        DATEADD ( 'DimDate'[Date], -1, MONTH )
				    )
				RETURN
				    IF ( NOT ISBLANK ( _Current ), _Current - COALESCE ( _Prior, 0 ) )
				```

		calculationItem 'SPLQ Diff' = ```
				
				VAR _Current = SELECTEDMEASURE ()
				VAR _Prior = 
				    CALCULATE (
				        SELECTEDMEASURE (),
				        DATEADD ( 'DimDate'[Date], -1, QUARTER )
				    )
				RETURN
				    IF ( NOT ISBLANK ( _Current ), _Current - COALESCE ( _Prior, 0 ) )
				```

		calculationItem 'SPLY Diff' = ```
				
				VAR _Current = SELECTEDMEASURE ()
				VAR _Prior = 
				    CALCULATE (
				        SELECTEDMEASURE (),
				        DATEADD ( 'DimDate'[Date], -1, YEAR )
				    )
				RETURN
				    IF ( NOT ISBLANK ( _Current ), _Current - COALESCE ( _Prior, 0 ) )
				```

		calculationItem 'SPLW Diff' = ```
				
				VAR _Current = SELECTEDMEASURE ()
				VAR _Prior = 
				    CALCULATE (
				        SELECTEDMEASURE (),
				        DATEADD ( 'DimDate'[Date], -7, DAY )
				    )
				RETURN
				    IF ( NOT ISBLANK ( _Current ), _Current - COALESCE ( _Prior, 0 ) )
				```

