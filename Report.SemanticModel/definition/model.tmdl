model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

/// Errors in queries that were loaded on 10/23/2026 4:27:30 PM.
queryGroup 'Query Errors - 10/23/2026 4:27:30 PM'

	annotation PBI_QueryGroupOrder = 0

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["FactTable","DimProducts","dim_inflatie","fnNutriscore","Errors in DimProducts","Project folder path"]

annotation PBI_ProTooling = ["CalcGroup","TMDLView_Desktop","DevMode","TMDL-Extension"]

ref table FactTable
