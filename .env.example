# =====================================================================
# Lidl Plus Data Pipeline - Environment Configuration Template
# =====================================================================
# Copy this file to '.env' or run 'auth_login.py' (or 'run.bat') to auto-generate it.

# REQUIRED: OAuth2 Refresh Token for Lidl Plus API access.
# Obtained automatically via auth_login.py or run.bat
LIDL_REFRESH_TOKEN=

# OPTIONAL: Two-letter country code for your Lidl Plus account (e.g. ro, de, fr, es, it, pl, at, ch).
# If omitted or left empty, the pipeline automatically detects your country from your JWT id_token.
# LIDL_COUNTRY=ro

# OPTIONAL: Explicit reporting language override (e.g. en, ro, de, fr, es, it, pl).
# If omitted, defaults to the primary language of LIDL_COUNTRY (or English if unsupported).
# LIDL_LANGUAGE=ro

# OPTIONAL: Open Food Facts enrichment mode:
# - auto (default): Uses local 'food.parquet' if found on disk; otherwise falls back to Live REST API v2.
# - parquet: Enforces offline scanning of local 'food.parquet'.
# - api: Enforces live querying of Open Food Facts REST API v2 (zero-download mode).
# OFF_MODE=auto

# OPTIONAL: Number of days before items marked as NOT_FOUND_OFF are re-queried (auto-healing TTL).
# Default: 30 days.
# OFF_NOT_FOUND_TTL_DAYS=30

# OPTIONAL: Custom HTTP User-Agent sent to Open Food Facts API (ODbL compliance).
# OFF_USER_AGENT=LidlConsumptionPipeline/1.0 (https://github.com/lidl-consumption-pipeline)

# =====================================================================
# OPTIONAL: Production AI enrichment (Groq only; disabled by default)
# =====================================================================
# AI_ENRICHMENT_MODE accepts:
# - off (default): no AI requests
# - categories: classify missing categories only
# - categories_and_nutrition: classify and estimate missing nutrition
# AI_ENRICHMENT_MODE=off
# AI_ENRICHMENT_BATCH_SIZE=20
# GROQ_API_KEY is required only when AI_ENRICHMENT_MODE is enabled. Never
# commit .env or include this key in logs/reports.
GROQ_API_KEY=
# Default: openai/gpt-oss-120b. Only the code's documented free-model allowlist
# is accepted; production does not fall back to paid models or other providers.
# GROQ_MODEL=openai/gpt-oss-120b

# =====================================================================
# OPTIONAL: AI evaluation harness only (ai_eval/; not a production provider)
# =====================================================================
# OpenRouter is available only to the isolated evaluation CLI. Production uses
# Groq only. Run `python -m ai_eval.runner --list-free-models` and choose a
# model ending in ':free' (or 'openrouter/free').
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
